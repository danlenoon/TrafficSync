# Copy to .env and fill in. .env is git-ignored; this file is committed.
# On a deployed host, set these in the dashboard instead: there is no .env there.

PORT=3000

# Local:   postgres://postgres:<your-password>@localhost:5432/trafficsync
# Hosted:  postgres://user:pass@host.neon.tech/trafficsync?sslmode=require
DATABASE_URL=postgres://postgres:<your-password>@localhost:5432/trafficsync

# Comma-separated, no trailing slash, no path. An origin is scheme + host + port.
CORS_ORIGINS=http://localhost:5173,https://danlenoon.github.io

# HTTP Basic Authentication credentials for API protection
APP_USERNAME=admin
APP_PASSWORD=your_secure_password

# Set to production on your host (e.g. Render). Express behaves better and suppresses stack traces.
NODE_ENV=development
